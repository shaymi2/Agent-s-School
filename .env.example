# The gym runs fully without any of these, using its deterministic
# heuristic trainee, judge and coach. Set them to train a real model.

# Anthropic (official SDK)
# ANTHROPIC_API_KEY=sk-ant-...
# GYM_TRAINEE_MODEL=claude-opus-5
# GYM_JUDGE_MODEL=claude-opus-5
# GYM_COACH_MODEL=claude-opus-5

# Any OpenAI-compatible endpoint, including local runtimes
# GYM_OPENAI_API_KEY=...
# GYM_OPENAI_BASE_URL=http://localhost:11434/v1
# GYM_OPENAI_MODEL=...

# Where the SQLite database lives (default .gym/gym.db)
# GYM_DB=.gym/gym.db

# Structured event logging to stderr
# GYM_LOG=1
